APP_NAME="Kobana POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://IP_VPS_ANDA_ATAU_DOMAIN

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=error

# -----------------------------------------------------------------
# Konfigurasi Database MySQL (Menghubungkan ke kontainer 'db')
# -----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=kobana_pos
DB_USERNAME=kobana_user
DB_PASSWORD=GantiPasswordUser_987654!
DB_ROOT_PASSWORD=GantiPasswordRoot_123456!

# Port & Host Akses VPS
APP_PORT=80
APP_SSL_PORT=443

# Akses Database MySQL (Termasuk MySQL Workbench)
# - Gunakan 127.0.0.1 untuk koneksi aman via MySQL Workbench SSH Tunnel (Rekomendasi Utama)
# - Gunakan 0.0.0.0 jika ingin membuka port MySQL langsung ke publik (Wajib atur firewall UFW)
DB_BIND_IP=127.0.0.1
FORWARD_DB_PORT=3306

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Media Penyimpanan Berkas Foto Bukti QRIS & Struk Kasir
FILESYSTEM_DISK=public

# Antrean Pekerjaan Latar Belakang (FP-Growth & Impor Excel)
QUEUE_CONNECTION=database

CACHE_STORE=database
BROADCAST_CONNECTION=log

MAIL_MAILER=log
