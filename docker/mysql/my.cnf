[mysqld]
# Konfigurasi Karakter & Kolasi (Wajib utf8mb4 untuk dukungan emoji, karakter internasional, dan Laravel)
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Autentikasi ramah konektor PHP
default_authentication_plugin = mysql_native_password

# Pengaturan Alokasi Memori (Disetel optimal untuk VPS dengan RAM 1GB - 4GB)
innodb_buffer_pool_size = 256M
innodb_log_file_size = 64M
innodb_file_per_table = 1
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT

# Batas Koneksi & Timeout (Optimal untuk MySQL Workbench agar koneksi tidak putus saat idle)
max_connections = 100
max_connect_errors = 1000
wait_timeout = 28800
interactive_timeout = 28800
net_read_timeout = 300
net_write_timeout = 300

# Percepat koneksi klien GUI (MySQL Workbench) tanpa DNS reverse lookup delay
skip-name-resolve = 1

# Pengaturan Paket Kueri (Penting untuk impor dataset massal & data mining)
max_allowed_packet = 64M

# Logging Kueri Lambat (Audit performa query)
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 2

# Mode SQL Standar Aman
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
